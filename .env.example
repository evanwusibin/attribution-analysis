# 本文件仅用于本地学习环境，不是生产配置模板。
# 生产环境必须通过密钥管理和部署平台注入配置，禁止复用其他项目的路径、凭据或运行配置。
ATTRIBUTION_ENV=local
ATTRIBUTION_DATABASE_URL=duckdb:///data/attribution_demo.db
ATTRIBUTION_RAG_MODE=remote
ATTRIBUTION_RAG_BASE_URL=http://127.0.0.1:8001
ATTRIBUTION_RAG_IMPORT_BASE_URL=http://127.0.0.1:8000
ATTRIBUTION_NL2SQL_MODE=demo
ATTRIBUTION_NL2SQL_BASE_URL=http://127.0.0.1:8012
ATTRIBUTION_INTEGRATION_TIMEOUT_SECONDS=30

# Docker Compose 访问宿主 MySQL 时使用（compose.yaml 引用；真实值只写本地 .env）
# MYSQL_PASSWORD=change-me-in-local-env

# S9 售前场景：瑞能 CRM SQLite 库路径（只读 ATTACH；未配置时 S9 场景返回 MISSING）
# ATTRIBUTION_CRM_DB_PATH=D:/path/to/crm_database.db

# LLM 默认是本地安全演示模式。远程验证时仅在本机 .env 注入 API key。
ATTRIBUTION_LLM_MODE=demo
ATTRIBUTION_LLM_PROVIDER=sensenova
# ATTRIBUTION_LLM_MODE=remote
# ATTRIBUTION_LLM_PROVIDER=sensenova
# ATTRIBUTION_LLM_BASE_URL=https://token.sensenova.cn/v1
# ATTRIBUTION_LLM_MODELS=sensenova-6.8-flash-lite,deepseek-v4-flash,glm-5.2
# ATTRIBUTION_LLM_API_KEY=
# 或使用供应商专属变量：SENSENOVA_API_KEY / STEPFUN_API_KEY
# 阶跃示例：ATTRIBUTION_LLM_PROVIDER=stepfun
# ATTRIBUTION_LLM_BASE_URL=https://api.stepfun.com/step_plan/v1
# ATTRIBUTION_LLM_MODELS=step-3.7-flash
# STEPFUN_API_KEY=
# ATTRIBUTION_LLM_TIMEOUT_SECONDS=30

# 生产模式必填项（示例保持为空，禁止把占位值部署到生产）。
# ATTRIBUTION_ENV=production
# ATTRIBUTION_DATABASE_URL=postgresql://<injected-user>:<injected-password>@<injected-host>/<injected-db>
# ATTRIBUTION_RAG_MODE=remote
# ATTRIBUTION_NL2SQL_MODE=remote
# ATTRIBUTION_AUTH_ISSUER=https://<injected-issuer>
# ATTRIBUTION_AUTH_AUDIENCE=<injected-audience>
# ATTRIBUTION_AUTH_JWKS_URL=https://<injected-issuer>/.well-known/jwks.json
# ATTRIBUTION_DMS_BASE_URL=https://<injected-dms-readonly-endpoint>

# 生产密钥、令牌、外部数据源路径和模型路径不得写入本文件或 Git。
